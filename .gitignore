```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
.env
.env.local
.env.*

# Logs
*.log

# Coverage reports
.coverage
coverage/
htmlcov/

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS specific
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
target/
*.so
*.dylib
*.dll
*.exe
*.out

# Dependencies
node_modules/
.mypy_cache/
.pytest_cache/
.gradle/
```